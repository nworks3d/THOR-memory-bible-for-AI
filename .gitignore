# Private memory snapshots exported from mimir hold real memories - never commit.
*.jsonl
# Local THOR stores (should live outside the repo, but guard against strays).
*.db
*.db-wal
*.db-shm
# Python tooling
__pycache__/
# Build/upload artifacts (e.g. the NAS source bundle)
*.zip
# Local MCP connector config (machine-specific absolute path)
.mcp.json
# Rollback copies of the connector config. They hold real absolute paths with
# the maintainer's username, and a stranger has no use for them.
.mcp.json.pre-*
# Measurement corpora and their outputs, mirrored from thor/.gitignore. A gold
# body is a real memory and an entity id names a real project, so these belong in
# the per-user data directory and never here. Mirrored because the eval harness
# writes relative to wherever it was started, and the repo root is a plausible
# place to start it.
golds*.json
percategory_queries*.json
queries*.json
items*.json
strata*.json
scores*.json
hits*.json
*_hits.json
thor-src-*.tar.gz
*.npy

# THOR 2.0 is the same project, not a separate one, so it lives here in thor2/
# rather than in a folder of its own. Two things inside it never belong in a
# clone. Cargo's build output is 27 GB and one `cargo build` reproduces all of
# it. The measurement material under thor2/eval/ is real memory text and real
# project names, for the same reason thor/eval/ is ignored wholesale above.
thor2/target/
thor2/target-*/
thor2/eval/
