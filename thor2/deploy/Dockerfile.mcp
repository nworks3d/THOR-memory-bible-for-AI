# THOR 2.0's memory server in a container, over stdio.
#
# This is NOT the NAS replica image - that one is `Dockerfile` beside this
# file, it ships the log-shipping receiver, and it opens a port. This one
# ships a single program that talks the memory protocol on standard input
# and output, which is what a directory or a client that wants to see the
# tool list needs. Nothing here listens on a network.
#
# Two things this image has to get right, both learned by running it:
#
# 1. `mcp` refuses to start when the store does not exist, on purpose: a
#    server that quietly creates an empty memory next to a typo in the path
#    is worse than one that stops and says the path is wrong (see
#    core::event_store::EventStore::open_existing). A container starts with
#    no store at all, so deploy/entrypoint.sh runs first and brings up a
#    properly seeded one - the working contract and the response-guard
#    rulebook, not a single placeholder note - before handing off to `mcp`.
#    Mount a real store on /data and that step is skipped and yours is opened
#    untouched; see entrypoint.sh's own header for the full account.
#
#    This is this image's own default; it says nothing about the OTHER
#    Dockerfile beside this one. `deploy/Dockerfile` (the NAS replica) still
#    defaults to starting the log-shipping receiver, and does so on purpose -
#    deploy/docker-compose.yml's thor2-recv service pins that role with its
#    own explicit command, so it never depends on either image's default.
#
# 2. No `semantic` feature. That pulls in the ONNX runtime and the embedding
#    model, which is a large download and a lot of build time for something
#    an introspecting client never calls. Search here answers on the letter,
#    exactly like the replica image. Build with the feature only if you
#    actually want meaning-based lookup inside the container.
#
# Build from the REPOSITORY ROOT, not from thor2/:
#
#   docker build -f thor2/deploy/Dockerfile.mcp -t thor-mcp .
#   docker run --rm -i -v thor-data:/data thor-mcp

FROM rust:1-bookworm AS build
WORKDIR /src
COPY thor2/ ./
# `initstore` is the headless store bootstrap deploy/entrypoint.sh calls on a
# first start - see its own doc comment for why that is a separate binary
# from `install` rather than `install` itself.
RUN cargo build --release --bin mcp --bin initstore

FROM debian:bookworm-slim

# How the public server directory proves this image belongs to the entry that
# claims it: the label has to match the `name` field in server.json at the
# repository root. Change one and the other stops verifying.
LABEL io.modelcontextprotocol.server.name="io.github.nworks3d/thor"

# What the package page shows a visitor. Without these it says "No description
# provided" and links nowhere, which is a poor first impression of a thing whose
# whole pitch is that it explains itself. `source` is also what makes the
# package page link back to the repository it was built from.
LABEL org.opencontainers.image.title="THOR" \
      org.opencontainers.image.description="Local memory for coding agents. A rule with a runnable proof can refuse a wrong command, and a second, separate memory holds everyday things - recipes, books read, a training log - where nothing can interrupt you." \
      org.opencontainers.image.source="https://github.com/nworks3d/THOR-memory-bible-for-AI" \
      org.opencontainers.image.url="https://github.com/nworks3d/THOR-memory-bible-for-AI" \
      org.opencontainers.image.licenses="GPL-3.0-or-later"

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/mcp /usr/local/bin/mcp
COPY --from=build /src/target/release/initstore /usr/local/bin/initstore

# The store lives here. Mount a volume to keep what the memory learns; without
# one it starts empty every run, which is fine for a health check and useless
# for anything else.
ENV THOR_DB=/data/thor.db
VOLUME /data

# Copied from the build stage's own checkout rather than the host context
# directly, so this Dockerfile only ever reads through the one COPY at the
# top (`COPY thor2/ ./`) - see entrypoint.sh for what this actually does.
COPY --from=build /src/deploy/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
